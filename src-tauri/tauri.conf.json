{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop AI Pet",
  "version": "0.1.0",
  "identifier": "com.desktop-ai-pet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "Desktop AI Pet",
        "width": 560,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Desktop AI Pet · 宠物助手",
        "width": 420,
        "height": 680,
        "resizable": false,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      },
      {
        "label": "chat",
        "title": "Desktop AI Pet · 聊天",
        "width": 340,
        "height": 480,
        "resizable": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png"]
  }
}
